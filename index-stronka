          </div>
          <div class="page-actions">
            <button class="btn btn-ghost" data-go="guide">← Back</button>
            <button class="btn btn-primary" data-go="home">Back to start</button>
          </div>
        </section>
      </div>
    </main>
  </div>
  <div id="toast" role="status" aria-live="polite"></div>

  <script>
  (() => {
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];
    const eur = n => '€' + Math.round(n).toLocaleString('en-US');

    /* ---------- Data ---------- */
    const SCREENS = [
      { id: 'home', label: 'Welcome' },
      { id: 'upload', label: 'Upload photo' },
      { id: 'analysis', label: 'Room analysis' },
      { id: 'ideas', label: 'Style ideas' },
      { id: 'materials', label: 'Materials & cost' },
      { id: 'guide', label: 'DIY guide' },
      { id: 'choices', label: 'Green choices' }
    ];

    const STYLES = [
      { id: 'warm', name: 'Warm minimalism', match: 96, desc: 'Natural textures, soft neutrals and a few timeless pieces.', blurb: 'Creamy mineral paint, oiled oak and undyed linen keep it calm and bright.', paint: 'warm white', palette: { wall: '#ece3d3', wall2: '#e2d7c3', floor: '#b8946b', floor2: '#a6825b', sofa: '#d8cbb4', sofa2: '#c7b89e', rug: '#cdbfa5', art: '#c4623a', plant: '#6e8a63', frame: '#fbf7ef' } },
      { id: 'nordic', name: 'Scandinavian calm', match: 91, desc: 'Pale timber, cool light and beautifully simple forms.', blurb: 'Soft grey-white walls, pale floor and blue-grey textiles maximise daylight.', paint: 'soft grey-white', palette: { wall: '#eef0ec', wall2: '#e2e6e1', floor: '#d6c29f', floor2: '#c6b08b', sofa: '#b7c1c2', sofa2: '#a2adae', rug: '#e5e3dc', art: '#5f7d8c', plant: '#7c9a77', frame: '#ffffff' } },
      { id: 'reclaimed', name: 'Modern reclaimed', match: 88, desc: 'Salvaged character with a deep, contemporary edge.', blurb: 'A deep green accent wall, dark oiled floor and rust tones add drama.', paint: 'forest green', palette: { wall: '#3f5a4a', wall2: '#364f40', floor: '#7a5840', floor2: '#664833', sofa: '#a5714c', sofa2: '#8f5f3e', rug: '#cdbfa5', art: '#e9b949', plant: '#8fae8f', frame: '#d9d2c4' } }
    ];

    // price: fixed € or per m² floor (perM2). co2 in kg saved (per m² if perM2).
    const MATERIALS = [
      { id: 'floor', ico: '🪵', name: 'Restore existing oak floor', sub: 'Sand + natural hardwax oil', tag: 'Keeps 100% of the floor', perM2: true, mat: 9, lab: 24, co2: 16, hours: 6, tools: ['Floor sander (rent, ~€45/day)', 'Hardwax oil & lint-free cloths'] },
      { id: 'paint', ico: '🎨', name: 'Mineral wall paint', sub: 'Silicate, breathable, low-VOC', tag: 'Near-zero VOC', perM2: true, mat: 7.5, lab: 18, co2: 2.5, hours: 5, tools: ['Roller, tray & angled brush', 'Filler, sandpaper & masking tape'] },
      { id: 'led', ico: '💡', name: 'Warm LED lighting', sub: '2700K, dimmable, 3 fittings', tag: '−80% energy', mat: 140, lab: 90, co2: 55, hours: 1.5, tools: ['Voltage tester & screwdriver'] },
      { id: 'curtains', ico: '🪟', name: 'Organic linen curtains', sub: 'Undyed European flax, 1 pair', tag: 'Renewable fibre', mat: 220, lab: 30, co2: 22, hours: 1, tools: ['Drill & wall plugs for the rail'] },
      { id: 'rug', ico: '🧶', name: 'Recycled wool rug', sub: '80% recycled fibre · 160 × 230 cm', tag: '80% recycled', mat: 260, lab: 0, co2: 38, hours: 0.25, tools: [] },
      { id: 'shelf', ico: '📚', name: 'Reclaimed timber shelving', sub: 'Salvaged boards, 2 × 120 cm', tag: 'Reused wood', mat: 160, lab: 60, co2: 30, hours: 1.5, tools: ['Spirit level & stud finder'] }
    ];

    const CHOICES = [
      { id: 'cork', cat: 'natural', ico: '🟫', bg: '#efe2cf', badge: 'TOP PICK', name: 'Cork underlay & pinboard', desc: 'Harvested without felling a tree; great for acoustics.', co2: 18, price: 85 },
      { id: 'lime', cat: 'natural', ico: '🪨', bg: '#ece9e1', badge: 'HEALTHY HOME', name: 'Natural lime plaster', desc: 'Breathable feature wall that regulates humidity.', co2: 24, price: 190 },
      { id: 'sofa', cat: 'recycled', ico: '🛋️', bg: '#e3e9df', badge: 'SECOND LIFE', name: 'Reupholster your sofa', desc: 'New recycled-fibre cover instead of a new sofa.', co2: 160, price: 420 },
      { id: 'tiles', cat: 'recycled', ico: '🔲', bg: '#e6e2ec', badge: 'RECYCLED', name: 'Recycled glass tiles', desc: 'Made from 95% post-consumer glass for a fireplace or nook.', co2: 20, price: 140 },
      { id: 'plants', cat: 'local', ico: '🪴', bg: '#dfe8dc', badge: 'LOCAL', name: 'Peat-free local plants', desc: 'Grown in a nursery within 50 km, in reusable pots.', co2: 6, price: 60 },
      { id: 'chairs', cat: 'local', ico: '🪑', bg: '#f1e4d7', badge: 'LOCAL', name: 'Vintage chairs, restored', desc: 'From a local reuse store, refinished with plant-based oil.', co2: 45, price: 150 }
    ];

    /* ---------- State ---------- */
    const STORE = 'renovo-green-v2';
    const defaults = () => ({ screen: 'home', size: 24, style: 'warm', mats: MATERIALS.map(m => m.id), diy: true, steps: [], extras: [], analysed: false, visited: ['home'] });
    let state = Object.assign(defaults(), safeParse(localStorage.getItem(STORE)));
    let photo = sessionStorage.getItem(STORE + '-photo') || null;
    let photoName = sessionStorage.getItem(STORE + '-name') || '';

    function safeParse(s) { try { return JSON.parse(s) || {}; } catch { return {}; } }
    function save() { localStorage.setItem(STORE, JSON.stringify(state)); }
    function savePhoto() {
      try {
        if (photo) { sessionStorage.setItem(STORE + '-photo', photo); sessionStorage.setItem(STORE + '-name', photoName); }
        else { sessionStorage.removeItem(STORE + '-photo'); sessionStorage.removeItem(STORE + '-name'); }
      } catch { /* image too large to keep between reloads — fine */ }
    }
    const style = () => STYLES.find(s => s.id === state.style) || STYLES[0];

    /* ---------- Illustration ---------- */
    function roomSVG(p, w = 800, h = 600) {
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="${w}" height="${h}" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="wl" x1="0" x2="1"><stop offset="0" stop-color="${p.wall}"/><stop offset="1" stop-color="${p.wall2}"/></linearGradient>
          <linearGradient id="fl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${p.floor}"/><stop offset="1" stop-color="${p.floor2}"/></linearGradient>
          <linearGradient id="lt" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff6d8" stop-opacity=".55"/><stop offset="1" stop-color="#fff6d8" stop-opacity="0"/></linearGradient>
        </defs>
        <rect width="800" height="600" fill="url(#wl)"/>
        <rect y="440" width="800" height="160" fill="url(#fl)"/>
        ${Array.from({ length: 9 }, (_, i) => `<line x1="${i * 100}" y1="440" x2="${i * 100 - 60}" y2="600" stroke="${p.floor2}" stroke-width="2" opacity=".6"/>`).join('')}
        <rect y="432" width="800" height="10" fill="${p.frame}" opacity=".8"/>
        <rect x="470" y="70" width="230" height="270" rx="4" fill="#cfe0dc" stroke="${p.frame}" stroke-width="14"/>
        <path d="M585 77v256M477 205h216" stroke="${p.frame}" stroke-width="8"/>
        <polygon points="470,340 700,340 640,600 330,600" fill="url(#lt)"/>
        <rect x="450" y="60" width="16" height="300" rx="6" fill="${p.rug}" opacity=".9"/>
        <rect x="704" y="60" width="16" height="300" rx="6" fill="${p.rug}" opacity=".9"/>
        <rect x="110" y="140" width="130" height="160" fill="${p.art}" stroke="${p.frame}" stroke-width="10"/>
        <circle cx="175" cy="200" r="34" fill="${p.frame}" opacity=".35"/>
        <rect x="270" y="190" width="150" height="10" rx="3" fill="${p.floor2}"/>
        <rect x="290" y="160" width="26" height="30" rx="4" fill="${p.sofa2}"/><rect x="330" y="150" width="18" height="40" rx="3" fill="${p.art}"/><circle cx="385" cy="176" r="14" fill="${p.plant}"/>
        <ellipse cx="330" cy="545" rx="280" ry="42" fill="${p.rug}"/>
        <rect x="80" y="330" width="440" height="110" rx="30" fill="${p.sofa}"/>
        <rect x="60" y="370" width="480" height="100" rx="26" fill="${p.sofa2}"/>
        <rect x="100" y="380" width="200" height="56" rx="18" fill="${p.sofa}"/><rect x="310" y="380" width="200" height="56" rx="18" fill="${p.sofa}"/>
        <rect x="95" y="468" width="16" height="36" rx="4" fill="${p.floor2}"/><rect x="490" y="468" width="16" height="36" rx="4" fill="${p.floor2}"/>
        <rect x="150" y="345" width="70" height="50" rx="14" fill="${p.art}" opacity=".85"/>
        <ellipse cx="330" cy="520" rx="90" ry="16" fill="${p.floor2}"/><rect x="320" y="520" width="20" height="40" fill="${p.floor2}"/>
        <path d="M640 560h80l-10-70h-60z" fill="${p.art}" opacity=".9"/>
        <path d="M680 490c-50-40-60-110-20-150 10 50 20 80 20 150zm0 0c40-50 90-70 110-50-20 30-60 50-110 50zm0 0c-10-70 10-130 60-150 0 60-20 110-60 150z" fill="${p.plant}"/>
        <path d="M620 250v180M590 430h60" stroke="${p.floor2}" stroke-width="5"/><path d="M590 250h60l-14-44h-32z" fill="${p.frame}"/>
      </svg>`;
    }
    const svgURL = svg => 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
    const SAMPLE = svgURL(roomSVG({ wall: '#ddd6c8', wall2: '#d2cab9', floor: '#a98a6b', floor2: '#957556', sofa: '#9f9a8b', sofa2: '#8d877a', rug: '#c7bba4', art: '#7d8a7a', plant: '#5f7a58', frame: '#f2eee5' }));

    /* ---------- Toast ---------- */
    let toastT;
    function toast(msg) { const t = $('#toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 2600); }

    /* ---------- Navigation ---------- */
    function renderNav() {
      $('#stepsNav').innerHTML = SCREENS.map((s, i) => `<li><button class="step-link" data-go="${s.id}" type="button"><span class="step-dot">${i + 1}</span>${s.label}</button></li>`).join('');
    }
    function go(id, push = true) {
      if (!SCREENS.some(s => s.id === id)) id = 'home';
      if (id === 'analysis' && !photo) { toast('Add a photo or use the sample room first'); id = 'upload'; if (!push) history.replaceState(null, '', '#upload'); }
      state.screen = id;
      if (!state.visited.includes(id)) state.visited.push(id);
      save();
      $$('.screen').forEach(s => s.classList.toggle('active', s.id === id));
      const idx = SCREENS.findIndex(s => s.id === id);
      $$('.step-link').forEach((b, i) => {
        b.classList.toggle('active', i === idx);
        b.classList.toggle('done', i !== idx && state.visited.includes(SCREENS[i].id));
        b.toggleAttribute('aria-current', i === idx);
      });
      $('#mobileStep').textContent = `${idx + 1} / ${SCREENS.length}`;
      document.title = `${SCREENS[idx].label} · RENOVO GREEN`;
      document.body.classList.remove('menu-open');
      if (push && location.hash !== '#' + id) history.pushState(null, '', '#' + id);
      window.scrollTo(0, 0);
      if (id === 'analysis') state.analysed ? showAnalysisDone() : runAnalysis();
    }
    document.addEventListener('click', e => {
      const el = e.target.closest('[data-go]');
      if (!el || el.disabled) return;
      e.preventDefault();
      go(el.dataset.go);
    });
    window.addEventListener('popstate', () => go(location.hash.slice(1) || 'home', false));
    $('#menuBtn').onclick = () => document.body.classList.add('menu-open');
    $('#scrim').onclick = () => document.body.classList.remove('menu-open');
    document.addEventListener('keydown', e => { if (e.key === 'Escape') document.body.classList.remove('menu-open'); });

    /* ---------- Photo ---------- */
    const fileInput = $('#fileInput'), dz = $('#dropzone');
    function setPhoto(src, name) {
      photo = src; photoName = name || '';
      state.analysed = false; save(); savePhoto();
      renderPhoto();
    }
    function renderPhoto() {
      const has = !!photo;
      dz.classList.toggle('hidden', has);
      $('#preview').classList.toggle('hidden', !has);
      $('#analyseBtn').disabled = !has;
      if (has) {
        $('#previewImg').src = photo;
        $('#scanImg').src = photo;
        $('#fileName').textContent = '✓ ' + (photoName || 'Photo ready for analysis');
        $('#projectThumb').innerHTML = `<img src="${photo}" alt="">`;
      } else {
        $('#projectThumb').innerHTML = roomSVG(style().palette, 44, 44);
      }
    }
    function handleFile(file) {
      if (!file) return;
      if (!file.type.startsWith('image/')) return toast('Please choose an image file');
      if (file.size > 10 * 1024 * 1024) return toast('That image is over 10 MB — try a smaller one');
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        // Downscale so it's light to keep around
        const max = 1400, k = Math.min(1, max / Math.max(img.width, img.height));
        const c = document.createElement('canvas');
        c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(url);
        setPhoto(c.toDataURL('image/jpeg', .85), file.name);
        toast('Photo added');
      };
      img.onerror = () => { URL.revokeObjectURL(url); toast("Couldn't read that image"); };
      img.src = url;
    }
    dz.addEventListener('click', () => fileInput.click());
    dz.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
    fileInput.addEventListener('change', () => { handleFile(fileInput.files[0]); fileInput.value = ''; });
    ['dragenter', 'dragover'].forEach(t => dz.addEventListener(t, e => { e.preventDefault(); dz.classList.add('drag'); }));
    ['dragleave', 'drop'].forEach(t => dz.addEventListener(t, e => { e.preventDefault(); dz.classList.remove('drag'); }));
    dz.addEventListener('drop', e => handleFile(e.dataTransfer.files[0]));
    $('#removePhoto').onclick = () => { setPhoto(null); fileInput.click(); };
    const useSample = () => { setPhoto(SAMPLE, 'Sample living room'); toast('Sample room loaded'); };
    $('#sampleBtn').onclick = useSample;
    $('#heroSample').onclick = () => { useSample(); go('analysis'); };
    $('#analyseBtn').onclick = () => { state.analysed = false; go('analysis'); };

    const sizeInput = $('#sizeInput');
    sizeInput.addEventListener('input', () => { state.size = +sizeInput.value; save(); renderAll(); });

    /* ---------- Analysis ---------- */
    let timers = [];
    function runAnalysis() {
      timers.forEach(clearTimeout); timers = [];
      const steps = $$('#scanSteps li'), tags = $$('#scan .tag'), ins = $$('#insights .insight');
      steps.forEach(s => s.className = '');
      tags.forEach(t => t.classList.remove('show'));
      ins.forEach(i => i.classList.remove('show'));
      $('#insights').classList.add('hidden');
      $('#progressCard').classList.remove('hidden');
      $('#scan').classList.add('scanning');
      $('#toIdeas').disabled = true;
      $('#scanStatus').textContent = 'Analysing';
      setPct(0);
      steps.forEach((s, i) => {
        timers.push(setTimeout(() => {
          if (i) steps[i - 1].className = 'done';
          s.className = 'active';
          tags[i]?.classList.add('show');
          setPct((i + .5) / steps.length * 100);
        }, 200 + i * 900));
      });
      timers.push(setTimeout(() => {
        steps.forEach(s => s.className = 'done');
        setPct(100);
        $('#scanStatus').textContent = 'Complete';
        state.analysed = true; save();
        timers.push(setTimeout(showAnalysisDone, 450));
      }, 200 + steps.length * 900));
    }
    function setPct(p) { $('#scanBar').style.width = p + '%'; $('#scanPct').textContent = Math.round(p) + '%'; }
    function showAnalysisDone() {
      $('#scan').classList.remove('scanning');
      $$('#scan .tag').forEach(t => t.classList.add('show'));
      $('#progressCard').classList.add('hidden');
      $('#insights').classList.remove('hidden');
      $$('#insights .insight').forEach((el, i) => timers.push(setTimeout(() => el.classList.add('show'), i * 120)));
      $('#toIdeas').disabled = false;
    }
    $('#rerunBtn').onclick = () => { state.analysed = false; runAnalysis(); };

    /* ---------- Styles ---------- */
    function renderStyles() {
      $('#styles').innerHTML = STYLES.map(s => `
        <button class="card style-card ${s.id === state.style ? 'selected' : ''}" role="radio" aria-checked="${s.id === state.style}" data-style="${s.id}" type="button">
          <div class="style-visual">${roomSVG(s.palette)}<span class="pill match ${s.match > 95 ? 'sun' : ''}">${s.match}% match</span><span class="style-check">✓</span></div>
          <div class="style-body"><h3>${s.name}</h3><p>${s.desc}</p>
            <div class="swatches">${['wall', 'floor', 'sofa', 'art', 'plant'].map(k => `<i style="background:${s.palette[k]}"></i>`).join('')}</div></div>
        </button>`).join('');
    }
    $('#styles').addEventListener('click', e => {
      const c = e.target.closest('.style-card'); if (!c) return;
      state.style = c.dataset.style; save(); renderAll();
      toast(style().name + ' selected');
    });

    /* ---------- Materials ---------- */
    const wallArea = () => state.size * 2.6; // rough wall area from floor area
    function matCost(m) {
      const qty = m.perM2 ? (m.id === 'paint' ? wallArea() : state.size) : 1;
      return { mat: m.mat * qty, lab: m.lab * qty, co2: m.co2 * (m.perM2 ? state.size : 1) };
    }
    function renderMaterials() {
      const s = style();
      $('#matList').innerHTML = MATERIALS.map(m => {
        const c = matCost(m);
        const sub = m.id === 'paint' ? `${m.sub} · ${s.paint} · ~${Math.round(wallArea())} m² walls` : m.id === 'floor' ? `${m.sub} · ${state.size} m²` : m.sub;
        return `<label class="mat">
          <input type="checkbox" data-mat="${m.id}" ${state.mats.includes(m.id) ? 'checked' : ''}>
          <span class="ico">${m.ico}</span>
          <span><strong>${m.name}</strong><small>${sub}</small><br><span class="pill">${m.tag}</span></span>
          <span class="price">${eur(c.mat)}<small>${m.perM2 ? eur(m.mat) + ' / m²' : 'materials'}</small></span>
        </label>`;
      }).join('');
    }
    $('#matList').addEventListener('change', e => {
      const id = e.target.dataset.mat; if (!id) return;
      state.mats = e.target.checked ? [...new Set([...state.mats, id])] : state.mats.filter(x => x !== id);
      save(); renderTotals(); renderGuide();
    });
    $('#diyToggle').addEventListener('change', e => { state.diy = e.target.checked; save(); renderTotals(); });

    function totals() {
      let mat = 0, lab = 0, co2 = 0;
      MATERIALS.filter(m => state.mats.includes(m.id)).forEach(m => { const c = matCost(m); mat += c.mat; lab += c.lab; co2 += c.co2; });
      const ex = CHOICES.filter(c => state.extras.includes(c.id));
      co2 += ex.reduce((a, c) => a + c.co2, 0);
      return { mat, lab, co2: Math.round(co2), extrasPrice: ex.reduce((a, c) => a + c.price, 0) };
    }
    function renderTotals() {
      const t = totals();
      const total = t.mat + (state.diy ? 0 : t.lab);
      $('#total').textContent = eur(total);
      $('#range').textContent = total ? `Typical range ${eur(total * .85)} – ${eur(total * 1.2)}` : 'Select materials to see an estimate';
      $('#matCost').textContent = eur(t.mat);
      $('#labCost').textContent = eur(t.lab);
      $('#labCost').classList.toggle('strike', state.diy);
      $('#saveRow').classList.toggle('hidden', !state.diy || !t.lab);
      $('#saveCost').textContent = '−' + eur(t.lab);
      $('#diyToggle').checked = state.diy;
      $$('[data-bind="co2"]').forEach(el => el.textContent = t.co2.toLocaleString('en-US'));
      $('#sideMeter').style.width = Math.min(100, t.co2 / 10) + '%';
      renderImpact(t);
    }

    /* ---------- Guide ---------- */
    function guideSteps() {
      const has = id => state.mats.includes(id);
      const s = style();
      const list = [{ id: 'prep', title: 'Clear & protect the room', text: 'Move furniture out or to the centre, cover it with old sheets, and open the windows.', time: 1, tags: ['Everyone'] }];
      if (has('floor')) list.push({ id: 'floor', title: 'Sand & oil the floor', text: `Sand ${state.size} m² with 60 → 120 grit, vacuum thoroughly, then work in two thin coats of hardwax oil along the grain.`, time: 6, tags: ['Mask on', 'Overnight drying'] });
      if (has('paint')) list.push({ id: 'walls', title: 'Repair & paint the walls', text: `Fill cracks, sand smooth, tape edges. Cut in with a brush, then roll two coats of ${s.paint} mineral paint in W-shaped strokes.`, time: 5, tags: ['Low-VOC', '4 h between coats'] });
      if (has('led')) list.push({ id: 'led', title: 'Swap in warm LED fittings', text: 'Switch off the circuit at the fuse box and test it is dead before swapping fittings. If in doubt, call an electrician.', time: 1.5, tags: ['Safety check'] });
      if (has('shelf')) list.push({ id: 'shelf', title: 'Hang reclaimed shelving', text: 'Find the studs or use heavy-duty plugs, level the brackets and oil the boards before mounting.', time: 1.5, tags: ['Second pair of hands'] });
      if (has('curtains') || has('rug')) list.push({ id: 'textiles', title: 'Layer in natural textiles', text: [has('curtains') && 'Fit the rail 10–15 cm above the window and hang the linen curtains', has('rug') && 'roll out the recycled wool rug so the front sofa legs sit on it'].filter(Boolean).join('; ') + '.', time: 1.25, tags: ['Quick win'] });
      list.push({ id: 'style', title: 'Style, then pass things on', text: 'Bring furniture back, add plants and art, and donate or sell anything you no longer need.', time: 1, tags: ['Zero waste'] });
      return list;
    }
    function renderGuide() {
      const steps = guideSteps();
      state.steps = state.steps.filter(id => steps.some(s => s.id === id));
      const hours = steps.reduce((a, s) => a + s.time, 0);
      $('#gSteps').textContent = steps.length;
      $('#gHours').textContent = Math.round(hours);
      $('#gDays').textContent = Math.max(1, Math.ceil(hours / 6));
      $('#gList').innerHTML = steps.map((s, i) => `
        <label class="gstep"><input type="checkbox" data-step="${s.id}" ${state.steps.includes(s.id) ? 'checked' : ''}>
          <span class="gcheck">${i + 1}</span>
          <div><strong>${s.title}</strong><p>${s.text}</p><div class="gmeta"><span class="pill sun">⏱ ${s.time < 1 ? Math.round(s.time * 60) + ' min' : s.time + ' h'}</span>${s.tags.map(t => `<span class="pill">${t}</span>`).join('')}</div></div>
        </label>`).join('');
      const tools = [...new Set(MATERIALS.filter(m => state.mats.includes(m.id)).flatMap(m => m.tools))];
      $('#toolkit').innerHTML = ['Drop cloths & old clothes', ...tools].map(t => `<li>${t}</li>`).join('');
      renderGuideProgress(steps.length);
    }
    function renderGuideProgress(n = guideSteps().length) {
      const done = state.steps.length;
      $('#gBar').style.width = (n ? done / n * 100 : 0) + '%';
      $('#gProgressTxt').textContent = `${done} of ${n} done`;
      $('#gDone').classList.toggle('hidden', done !== n);
    }
    $('#gList').addEventListener('change', e => {
      const id = e.target.dataset.step; if (!id) return;
      state.steps = e.target.checked ? [...new Set([...state.steps, id])] : state.steps.filter(x => x !== id);
      save(); renderGuideProgress();
      if (e.target.checked && state.steps.length === guideSteps().length) toast('Renovation complete 🎉');
    });
    $('#printBtn').onclick = () => window.print();

    /* ---------- Green choices ---------- */
    let filter = 'all';
    function renderChoices() {
      const list = CHOICES.filter(c => filter === 'all' || c.cat === filter);
      $('#choiceGrid').innerHTML = list.map(c => {
        const added = state.extras.includes(c.id);
        return `<article class="card choice ${added ? 'added' : ''}">
          <div class="choice-visual" style="background:${c.bg}"><span class="pill">${c.badge}</span><span aria-hidden="true">${c.ico}</span></div>
          <div class="choice-body"><h3>${c.name}</h3><p>${c.desc}</p>
            <div class="choice-meta"><span>🌱 −${c.co2} kg CO₂e</span><strong>${eur(c.price)}</strong></div>
            <button class="add-btn" data-choice="${c.id}" type="button" aria-pressed="${added}">${added ? '✓ Added to project' : '+ Add to project'}</button></div>
        </article>`;
      }).join('');
      $('#choiceCount').textContent = `${list.length} recommendation${list.length === 1 ? '' : 's'}`;
    }
    $('#filters').addEventListener('click', e => {
      const b = e.target.closest('.chip'); if (!b) return;
      filter = b.dataset.filter;
      $$('#filters .chip').forEach(c => c.classList.toggle('active', c === b));
      renderChoices();
    });
    $('#choiceGrid').addEventListener('click', e => {
      const b = e.target.closest('[data-choice]'); if (!b) return;
      const id = b.dataset.choice, c = CHOICES.find(x => x.id === id);
      const on = !state.extras.includes(id);
      state.extras = on ? [...state.extras, id] : state.extras.filter(x => x !== id);
      save(); renderChoices(); renderTotals();
      toast(on ? `${c.name} added` : `${c.name} removed`);
    });
    function renderImpact(t) {
      const grades = [[900, 'A+', 'Outstanding — this is about as light as a renovation gets.'], [650, 'A', 'Excellent. A couple more extras could take you to A+.'], [400, 'B', 'Good start. Add a few extras below to push your rating higher.'], [150, 'C', 'Keeping your floor and adding natural textiles makes a big difference.'], [0, 'D', 'Select some materials to start building your impact.']];
      const [, g, txt] = grades.find(([min]) => t.co2 >= min);
      $('#grade').textContent = g;
      $('#gradeText').textContent = txt;
      const items = state.mats.length + state.extras.length, total = MATERIALS.length + CHOICES.length;
      $('#renewPct').textContent = Math.round(items / total * 100) + '%';
      $('#extrasCount').textContent = state.extras.length;
    }

    /* ---------- Download ---------- */
    $('#downloadBtn').onclick = () => {
      const t = totals(), s = style();
      const lines = [
        'RENOVO GREEN — Renovation plan', '='.repeat(32), '',
        `Room: Living room, ${state.size} m²`, `Style: ${s.name}`, '',
        'MATERIALS',
        ...MATERIALS.filter(m => state.mats.includes(m.id)).map(m => `  [ ] ${m.name} — ${eur(matCost(m).mat)}`),
        ...(state.extras.length ? ['', 'GREEN EXTRAS', ...CHOICES.filter(c => state.extras.includes(c.id)).map(c => `  [ ] ${c.name} — ${eur(c.price)}`)] : []),
        '', `Materials: ${eur(t.mat)}`, `Labour: ${state.diy ? 'DIY (saving ' + eur(t.lab) + ')' : eur(t.lab)}`, `Extras: ${eur(t.extrasPrice)}`,
        `Estimated total: ${eur(t.mat + (state.diy ? 0 : t.lab) + t.extrasPrice)}`, `CO2e saved: ~${t.co2} kg`, '',
        'DIY STEPS', ...guideSteps().map((g, i) => `  ${state.steps.includes(g.id) ? '[x]' : '[ ]'} ${i + 1}. ${g.title} (${g.time} h)`), ''
      ];
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/plain' }));
      a.download = 'renovo-green-plan.txt';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      toast('Plan downloaded');
    };

    $('#resetBtn').onclick = () => {
      if (!confirm('Start a new project? Your current selections and progress will be cleared.')) return;
      state = defaults(); setPhoto(null); save(); renderAll(); go('home');
      toast('New project started');
    };

    /* ---------- Render ---------- */
    function renderAll() {
      const s = style();
      sizeInput.value = state.size;
      $('#sizeOut').textContent = state.size + ' m²';
      $$('[data-bind="size"]').forEach(el => el.textContent = state.size);
      $$('[data-bind="style"]').forEach(el => el.textContent = s.name);
      $('#styleName').textContent = s.name;
      $('#styleBlurb').textContent = s.blurb;
      $('#projectMeta').textContent = `${state.size} m² · ${s.name}`;
      $('#heroArt').innerHTML = roomSVG(s.palette);
      renderStyles(); renderMaterials(); renderTotals(); renderGuide(); renderChoices(); renderPhoto();
    }

    $('#sampleThumb').innerHTML = `<img src="${SAMPLE}" alt="" style="width:100%;height:100%;object-fit:cover">`;
    renderNav();
    renderAll();
    go(location.hash.slice(1) || state.screen || 'home', false);
  })();
  </script>
</body>
</html>
